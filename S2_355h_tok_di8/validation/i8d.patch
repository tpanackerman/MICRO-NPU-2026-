+    post_ff: &HbmTensor<bf16, Chip, impl M>,
+    layer_scalar: &HbmTensor<bf16, Chip, impl M>,
+    res_out: &mut HbmTensor<bf16, Chip, m![Rh, Tk128, C32, E32]>,
+    had: &HadT,
