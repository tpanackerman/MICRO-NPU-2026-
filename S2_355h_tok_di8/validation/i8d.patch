+        let w4: Vec<u8> = (0..ROWS * K / 2).map(|_| rng.next() as u8).collect();
+        let s8: Vec<u8> = (0..ROWS * K / 16).map(|_| 0x20 + (rng.next() % 0x31) as u8).collect();
+        let rgs = 1.0 / 20864.0;
